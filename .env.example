# 复制本文件为 .env 后再填写本地配置。
# .env 只保存在你自己的电脑上，不要提交到仓库。

# 登录信息：请在本地填写，不要公开分享。
CX_USERNAME=
CX_PASSWORD=

# 课程名称关键词。建议填写课程标题中的稳定片段。
CX_COURSE_KEYWORD=

# 已有准确的授权课程 URL 时可填写；设置后会跳过课程名称匹配。
CX_COURSE_URL=

# 指定章节关键词；留空时会尝试查找未完成任务点。
CX_CHAPTER_KEYWORD=

# 浏览器设置
CX_HEADLESS=false
CX_BROWSER_CHANNEL=chrome
CX_BROWSER_EXECUTABLE_PATH=
CX_SLOW_MO_MS=100

# 登录页地址。一般不需要改。
CX_LOGIN_URL=https://passport2.chaoxing.com/login?fid=&newversion=true&refer=https%3A%2F%2Fi.chaoxing.com

# 执行参数
CX_PLAYBACK_RATE=1.0
CX_MAX_CHAPTERS=100
CX_STOP_WHEN_NO_NEXT=true
CX_AUTO_COMMITMENT=false
# 等同于 --fast-actions：缩短点击/输入、课件停留和部分固定等待。尚未在真实课程上验证，默认关闭。
CX_FAST_ACTIONS=false
# 同一个任务点最多重复进入几次；超过就判定卡住并以失败退出，避免整夜空转。
CX_MAX_UNIT_REVISITS=3
# 单个任务点失败后的重试次数。只重试、不跳过 —— 跳过会静默留下没看完的内容。
CX_UNIT_RETRIES=2

# 超时和等待
CX_TIMEOUT_MS=15000
CX_LOOKUP_TIMEOUT_MS=30000
CX_MIN_ACTION_DELAY_SECONDS=2.0
CX_MAX_ACTION_DELAY_SECONDS=5.0
CX_PROGRESS_POLL_SECONDS=10.0
CX_MAX_VIDEO_WAIT_SECONDS=21600
# 等待 networkidle 的预算。学习页有心跳/分片请求，往往永远到不了 idle，
# 所以这里只给一个小预算，超时就继续，不要设成 CX_TIMEOUT_MS 那么大。
CX_SETTLE_TIMEOUT_MS=3000
CX_COMMITMENT_TIMEOUT_MS=10000
CX_NEXT_NAVIGATION_TIMEOUT_MS=10000
# 等待点击后弹出新标签页的预算。随机延迟已挪出该窗口，所以这里是纯等待时间。
CX_POPUP_TIMEOUT_MS=5000
# 点击登录后等待页面离开 passport 登录页（以及匹配登录成功标识）的预算。
CX_LOGIN_CHECK_TIMEOUT_MS=8000
CX_COURSEWARE_HOLD_SECONDS=1.0
CX_COMPLETION_SETTLE_SECONDS=5.0
CX_LEARNING_CARD_SWITCH_WAIT_SECONDS=1.0

# 视频时序
# 进入任务点后等待 <video> 出现的时间。
CX_VIDEO_INITIAL_WAIT_SECONDS=12.0
# 已确认整页没有任何 video 标签时改用的短等待（课件/文档/测验类任务点）。
CX_VIDEO_INITIAL_WAIT_NONVIDEO_SECONDS=2.0
CX_VIDEO_SOURCE_READY_WAIT_SECONDS=15.0
CX_VIDEO_ROUTE_SWITCH_WAIT_SECONDS=3.0
# 判定播放完成后的静置时间，留给平台上报进度。调小有丢失完成记录的风险。
CX_VIDEO_COMPLETION_SETTLE_SECONDS=2.0

# 进度轮询与卡顿恢复
CX_PROGRESS_MIN_POLL_SECONDS=0.5
CX_PROGRESS_COMPLETION_MARGIN_SECONDS=0.8
# 停滞判定阈值。注意它会和 轮询间隔 × 倍速 一起参与判断：
# 轮询过密时（poll × rate 接近该值）容易误判，启动时会有警告提示。
CX_PROGRESS_STALL_EPSILON_SECONDS=0.5
CX_PROGRESS_STALL_POLLS=3
CX_MAX_VIDEO_RECOVERY_ATTEMPTS=18
# 连续多少轮读不到视频时长就放弃该任务点。
# 防止 live/HLS 这类非有限时长的流一路吃满 CX_MAX_VIDEO_WAIT_SECONDS（默认 6 小时）。
CX_MAX_UNKNOWN_DURATION_POLLS=30

# 元素查找
# 单个 frame 上的最小探测时长；总预算由调用方的 timeout 分摊。
CX_LOCATOR_PROBE_MIN_MS=150
CX_PLAY_CONTROL_PROBE_MS=1000

# 课程名称模糊匹配
CX_COURSE_MATCH_MIN_SCORE=0.72
CX_COURSE_MATCH_AMBIGUOUS_DELTA=0.06

# 平台验证码或人工验证需要用户自行处理；脚本不会绕过验证。
CX_MANUAL_VERIFICATION_WAIT_SECONDS=0
CX_VERIFICATION_POLL_SECONDS=2.0

# 调试截图目录。截图可能包含个人信息，请不要提交。
CX_SCREENSHOT_DIR=logs/screenshots

# 保存登录会话的文件路径。留空=不保存（默认）。
# 填了之后重启不必重跑登录，也就绕开了最容易触发验证码的那一步。
# 注意：该文件含登录 cookie，等同于凭据。.gitignore 已覆盖 storage_state*，
# 但仍建议放在仓库目录之外。
CX_STORAGE_STATE_PATH=

# 选择器逃生口：每个选择器都可以用 CX_SELECTOR_<键名大写> 覆盖，
# 超星改版导致脚本失效时不用改代码。默认值见 main.py 的 CONFIG["selectors"]。
# 下面几个是最容易随改版失效的，按需取消注释再填：
#CX_SELECTOR_CHAPTERS_TAB=
#CX_SELECTOR_CHAPTER_ITEM=
#CX_SELECTOR_CHAPTER_CATALOG_ITEM=
#CX_SELECTOR_NEXT_CHAPTER=
#CX_SELECTOR_NEXT_CONTROL=
#CX_SELECTOR_VIDEO_PLAY_CONTROL=
#CX_SELECTOR_LEARNING_CARD_TABS=
# 登录成功后才会出现的元素；填了它，登录校验就不只靠"是否离开 passport 页"。
#CX_SELECTOR_LOGIN_SUCCESS_MARKER=
